{
  "this-is-a-comment": "This file is a configuration for providing additional context named specification for each gates.  Each gate (id) can have bindings to the specification defined here for eg; assertion gate bounded to the myspec binding.",
  "specifications": {
    "mbppspec": {
      "kind": "assertion:builder",
      "source": "sources/mbpp.json",
      "mapper": "provider.mbpp.MBPPAssertionMapper",
      "args": {
        "field": "test_list"
      }
    }
  },
  "demo-specifications": {
     "myspec": {
      "kind": "assertion",
      "assertions": [
        {
          "source": { "kind": "file", "path": "examples/example3.py" },
          "target": {
            "kind": "function",
            "name": "add_two_numbers"
          },
          "rules": [
            { "args": [1, 2], "expected": 3},
            { "args" : [-1, 1], "expected": 0},
            { "args": [-1, -1], "expected": -2}
          ]
        }
      ]
    }
  },
  "bindings": {
    "mbppspec": "assertion"
  }
}
